---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="28" height="28" viewBox="0 0 768 767.999994" preserveAspectRatio="xMidYMid meet" class="w-7 h-7 mb-1 mr-2 inline-block">
                    <path stroke-linecap="butt" transform="matrix(0.75, 0, 0, 0.75, -253.320424, -273.659995)" fill="none" stroke-linejoin="miter" d="M 976.734634 702.843615 C 961.187757 679.807154 944.70338 661.354027 927.286712 647.484234 C 899.354417 625.218606 868.666913 620.661314 835.218993 633.812357 C 803.739823 646.239442 781.61482 669.416528 768.849194 703.343615 " stroke="hsl(var(--hue), 60%, 60%)" stroke-width="2" stroke-opacity="1" stroke-miterlimit="4" opacity="0.9" />
                    <path stroke-linecap="butt" transform="matrix(0.75, 0, 0, 0.75, -253.320424, -273.659995)" fill="none" stroke-linejoin="miter" d="M 984.297135 803.400918 C 958.42734 848.31759 931.172129 894.723845 902.521084 942.614476 C 887.307541 968.051979 872.073164 989.765523 856.812745 1007.760316 C 834.739826 1033.817611 804.000239 1039.432195 764.604402 1024.604068 " stroke="hsl(var(--hue), 60%, 60%)" stroke-width="2" stroke-opacity="1" stroke-miterlimit="4" opacity="0.9" />
